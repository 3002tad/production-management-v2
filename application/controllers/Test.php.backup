<?php

defined('BASEPATH') or exit('No direct script access allowed');

/**
 * Test Controller - UC7 Priority Allocation Tests
 */
class Test extends CI_Controller
{
    public function __construct()
    {
        parent::__construct();
        $this->load->model('OrderModel');
        $this->load->model('CrudModel');
        $this->load->library('session');

        // Only allow admin access
        if (!$this->session->userdata('user_id') || $this->session->userdata('role_name') !== 'system_admin') {
            show_error('Access Denied - Admin Only', 403);
        }
    }

    /**
     * Run UC7 Priority Allocation Tests
     */
    public function uc7_priority()
    {
        header('Content-Type: text/plain; charset=utf-8');

        echo "=== UC7 PRIORITY ALLOCATION TEST ===\n\n";

        // ===== SETUP TEST DATA =====
        echo "1. SETUP TEST DATA\n";
        echo "-------------------\n";

        // Reset stock
        $this->db->query("UPDATE finished_stock SET quantity_in_stock = 100 WHERE id_product = 1001");
        $this->db->query("UPDATE material SET stock = 10000 WHERE id_material IN (1001, 1002, 1003, 1006)");

        // Clear existing test orders
        $this->db->query("DELETE FROM project WHERE project_name LIKE 'TEST-PRIORITY-%'");

        echo "✓ Reset stock: 100 units of product 1001\n";
        echo "✓ Reset materials: 10000 units each\n";
        echo "✓ Cleared existing test orders\n\n";

        // ===== TEST 1: CREATE ORDERS WITH DIFFERENT DEADLINES =====
        echo "2. CREATE ORDERS WITH DIFFERENT DEADLINES\n";
        echo "-----------------------------------------\n";

        // Order 1: Urgent (tomorrow)
        $order1 = [
            'id_cust' => 1001,
            'id_product' => 1001,
            'diameter' => 0.5,
            'qty_request' => 30,
            'entry_date' => date('Y-m-d', strtotime('+1 day')),
            'pr_status' => 1,
            'customer_request' => 'TEST-PRIORITY-URGENT'
        ];

        $result1 = $this->OrderModel->createOrder($order1);
        echo "Order 1 (URGENT - tomorrow): " . ($result1['success'] ? 'SUCCESS' : 'FAILED') . "\n";
        if ($result1['success']) {
            echo "  - Project ID: {$result1['id_project']}\n";
            $allocation1 = json_decode($result1['stock_allocation'], true);
            echo "  - From stock: {$allocation1['from_stock']}, For production: {$allocation1['for_production']}\n";
        }

        // Order 2: Less urgent (next week)
        $order2 = [
            'id_cust' => 1001,
            'id_product' => 1001,
            'diameter' => 0.5,
            'qty_request' => 40,
            'entry_date' => date('Y-m-d', strtotime('+7 days')),
            'pr_status' => 1,
            'customer_request' => 'TEST-PRIORITY-NORMAL'
        ];

        $result2 = $this->OrderModel->createOrder($order2);
        echo "\nOrder 2 (NORMAL - next week): " . ($result2['success'] ? 'SUCCESS' : 'FAILED') . "\n";
        if ($result2['success']) {
            echo "  - Project ID: {$result2['id_project']}\n";
            $allocation2 = json_decode($result2['stock_allocation'], true);
            echo "  - From stock: {$allocation2['from_stock']}, For production: {$allocation2['for_production']}\n";
        }

        // Order 3: Most urgent (today)
        $order3 = [
            'id_cust' => 1001,
            'id_product' => 1001,
            'diameter' => 0.5,
            'qty_request' => 20,
            'entry_date' => date('Y-m-d'),
            'pr_status' => 1,
            'customer_request' => 'TEST-PRIORITY-MOST-URGENT'
        ];

        $result3 = $this->OrderModel->createOrder($order3);
        echo "\nOrder 3 (MOST URGENT - today): " . ($result3['success'] ? 'SUCCESS' : 'FAILED') . "\n";
        if ($result3['success']) {
            echo "  - Project ID: {$result3['id_project']}\n";
            $allocation3 = json_decode($result3['stock_allocation'], true);
            echo "  - From stock: {$allocation3['from_stock']}, For production: {$allocation3['for_production']}\n";
        }

        echo "\n";

        // ===== TEST 2: VERIFY DB UPDATES =====
        echo "3. VERIFY DATABASE UPDATES\n";
        echo "---------------------------\n";

        // Check finished stock
        $stock_query = $this->db->get_where('finished_stock', ['id_product' => 1001]);
        $current_stock = $stock_query->row()->quantity_in_stock ?? 0;
        echo "Current finished stock: {$current_stock} (should be 100 - 30 - 40 - 20 = 10)\n";

        // Check material stock (should NOT be reduced yet)
        $material_query = $this->db->get_where('material', ['id_material' => 1001]);
        $current_material = $material_query->row()->stock ?? 0;
        echo "Current material stock (1001): {$current_material} (should be 10000 - NO REDUCTION YET)\n";

        // Check project records
        $projects = $this->db->query("
            SELECT id_project, project_name, entry_date, qty_request, stock_allocation, finished_stock_available
            FROM project
            WHERE project_name LIKE 'TEST-PRIORITY-%'
            ORDER BY entry_date ASC
        ")->result();

        echo "\nProject Records:\n";
        foreach ($projects as $project) {
            $allocation = json_decode($project->stock_allocation, true);
            echo "- {$project->project_name} (ID:{$project->id_project}, Deadline:{$project->entry_date})\n";
            echo "  Qty: {$project->qty_request}, Available Stock: {$project->finished_stock_available}\n";
            echo "  Allocation: from_stock={$allocation['from_stock']}, for_production={$allocation['for_production']}\n\n";
        }

        // ===== TEST 3: VERIFY PRIORITY LOGIC =====
        echo "4. VERIFY PRIORITY ALLOCATION LOGIC\n";
        echo "-------------------------------------\n";

        // The most urgent order (today) should get stock first
        $urgent_order = $this->db->query("
            SELECT id_project, stock_allocation
            FROM project
            WHERE customer_request = 'TEST-PRIORITY-MOST-URGENT'
        ")->row();

        if ($urgent_order) {
            $allocation = json_decode($urgent_order->stock_allocation, true);
            $urgent_from_stock = $allocation['from_stock'] ?? 0;

            echo "Most urgent order (today) got {$urgent_from_stock} from stock\n";
            echo "Expected: 20 (full allocation since it's most urgent)\n";

            if ($urgent_from_stock == 20) {
                echo "✓ PRIORITY LOGIC WORKS: Most urgent order gets full stock allocation\n";
            } else {
                echo "✗ PRIORITY LOGIC FAILED: Most urgent order should get 20 from stock\n";
            }
        }

        // ===== TEST 4: SIMULATE PRODUCTION START =====
        echo "\n5. SIMULATE PRODUCTION START (MATERIAL REDUCTION)\n";
        echo "-------------------------------------------------\n";

        if ($urgent_order) {
            // Start production for the most urgent order
            $this->db->insert('finished_report', [
                'id_project' => $urgent_order->id_project,
                'total_finished' => 20,
                'fdate' => date('Y-m-d'),
                'created_at' => date('Y-m-d H:i:s')
            ]);

            echo "✓ Simulated production start for most urgent order\n";

            // Check material stock now (should be reduced)
            $material_after = $this->db->get_where('material', ['id_material' => 1001])->row()->stock ?? 0;
            echo "Material stock after production start: {$material_after}\n";

            $expected_reduction = 20 * 10; // 20 products * 10g per unit (from BOM)
            $expected_stock = 10000 - $expected_reduction;

            if ($material_after == $expected_stock) {
                echo "✓ MATERIAL REDUCTION WORKS: Stock reduced only when production starts\n";
            } else {
                echo "✗ MATERIAL REDUCTION FAILED: Expected {$expected_stock}, got {$material_after}\n";
            }
        }

        echo "\n=== TEST COMPLETED ===\n";
    }

    /**
     * Test all 8 warning scenarios
     */
    public function all_scenarios()
    {
        header('Content-Type: text/plain; charset=utf-8');

        echo "=== TEST ALL 8 WARNING SCENARIOS ===\n\n";

        // ===== RESET DATABASE =====
        echo "1. RESET DATABASE\n";
        echo "-----------------\n";

        // Clear test orders
        $this->db->query("DELETE FROM project WHERE project_name LIKE '%TESTCASE%' OR created_at > DATE_SUB(NOW(), INTERVAL 1 HOUR())");

        // Reset stock
        $this->db->query("UPDATE finished_stock SET quantity_in_stock = 35, quantity_received = 35, quantity_issued = 0, last_updated = NOW() WHERE id_product = 1001");

        // Reset materials
        $this->db->query("UPDATE material SET stock = 5000, min_stock = 1000 WHERE id_material = 1001");
        $this->db->query("UPDATE material SET stock = 10000, min_stock = 1000 WHERE id_material = 1002");
        $this->db->query("UPDATE material SET stock = 5000, min_stock = 1000 WHERE id_material = 1003");
        $this->db->query("UPDATE material SET stock = 5000, min_stock = 1000 WHERE id_material = 1004");
        $this->db->query("UPDATE material SET stock = 2000, min_stock = 500 WHERE id_material = 1005");
        $this->db->query("UPDATE material SET stock = 3000, min_stock = 500 WHERE id_material = 1006");
        $this->db->query("UPDATE material SET stock = 2000, min_stock = 500 WHERE id_material = 1007");
        $this->db->query("UPDATE material SET stock = 1000, min_stock = 1000 WHERE id_material = 1008");

        echo "✓ Database reset completed\n\n";

        // ===== CREATE TEST ORDERS =====
        echo "2. CREATE TEST ORDERS\n";
        echo "---------------------\n";

        $test_cases = [
            [
                'name' => 'TESTCASE 1: Stock Available',
                'product' => 1001,
                'qty' => 10,
                'deadline' => '2025-12-31',
                'expected_badge' => 'info'
            ],
            [
                'name' => 'TESTCASE 2: Normal Production',
                'product' => 1001,
                'qty' => 50,
                'deadline' => '2025-12-31',
                'expected_badge' => 'success'
            ],
            [
                'name' => 'TESTCASE 3: Material Shortage',
                'product' => 1001,
                'qty' => 2000,
                'deadline' => '2025-12-31',
                'expected_badge' => 'warning'
            ],
            [
                'name' => 'TESTCASE 4: Level 2 Required',
                'product' => 1001,
                'qty' => 150000,
                'deadline' => '2025-12-31',
                'expected_badge' => 'warning'
            ],
            [
                'name' => 'TESTCASE 5: Capacity Shortage',
                'product' => 1001,
                'qty' => 100000,
                'deadline' => '2025-12-16',
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 6: Missing BOM',
                'product' => 1004,
                'qty' => 100,
                'deadline' => '2025-12-31',
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 7: NULL Materials',
                'product' => 1006,
                'qty' => 10000,
                'deadline' => '2025-12-31',
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 8: Deadline Passed',
                'product' => 1001,
                'qty' => 100,
                'deadline' => '2025-12-01',
                'expected_badge' => 'dark'
            ]
        ];

        $created_orders = [];

        foreach ($test_cases as $i => $test) {
            $order_data = [
                'id_cust' => 1001,
                'id_product' => $test['product'],
                'diameter' => 0.5,
                'qty_request' => $test['qty'],
                'entry_date' => $test['deadline'],
                'pr_status' => 0,
                'customer_request' => $test['name']
            ];

            $result = $this->OrderModel->createOrder($order_data);

            if ($result['success']) {
                $order_id = $result['id_project'];
                $created_orders[] = $order_id;
                echo "✓ {$test['name']} - ID: {$order_id}\n";

                // Refresh warnings
                $this->OrderModel->refreshWarnings($order_id);
            } else {
                echo "✗ {$test['name']} - FAILED: " . ($result['message'] ?? 'Unknown error') . "\n";
            }
        }

        echo "\n";

        // ===== VERIFY RESULTS =====
        echo "3. VERIFY RESULTS\n";
        echo "-----------------\n";

        foreach ($created_orders as $order_id) {
            $order = $this->db->get_where('project', ['id_project' => $order_id])->row();

            echo "\n--- ORDER ID: {$order_id} ---\n";
            echo "Name: {$order->customer_request}\n";
            echo "Warning Flag: {$order->warning_flag}\n";

            if (!empty($order->warning_details)) {
                $warnings = json_decode($order->warning_details, true);
                echo "Warnings:\n";

                // Determine badge color based on warnings
                $badge_color = 'success'; // default

                if (isset($warnings['deadline_passed'])) {
                    $badge_color = 'dark';
                    echo "  - DEADLINE PASSED: {$warnings['deadline_passed']}\n";
                } elseif (isset($warnings['missing_materials_warning'])) {
                    $badge_color = 'danger';
                    echo "  - MISSING MATERIALS: {$warnings['missing_materials_warning']}\n";
                } elseif (isset($warnings['material_warning'])) {
                    $badge_color = 'warning';
                    echo "  - MATERIAL WARNING: {$warnings['material_warning']}\n";
                } elseif (isset($warnings['capacity_warning'])) {
                    $badge_color = 'warning';
                    echo "  - CAPACITY WARNING: {$warnings['capacity_warning']}\n";
                } elseif (isset($warnings['stock_status']) && $warnings['stock_status'] === 'sufficient') {
                    $badge_color = 'info';
                    echo "  - STOCK AVAILABLE: {$warnings['finished_stock_info']}\n";
                }

                // Check if badge matches expected
                $test_index = array_search($order_id, $created_orders);
                if ($test_index !== false) {
                    $expected = $test_cases[$test_index]['expected_badge'];
                    if ($badge_color === $expected) {
                        echo "  ✓ BADGE CORRECT: {$badge_color}\n";
                    } else {
                        echo "  ✗ BADGE WRONG: Expected {$expected}, Got {$badge_color}\n";
                    }
                }

                // Show key warnings
                if (isset($warnings['material_status'])) {
                    echo "  - Material Status: {$warnings['material_status']}\n";
                }
                if (isset($warnings['capacity_info'])) {
                    echo "  - Capacity Level: {$warnings['capacity_info']['level']}\n";
                }

            } else {
                echo "No warnings\n";
            }
        }

        // ===== SUMMARY =====
        echo "\n4. SUMMARY\n";
        echo "----------\n";

        $total_orders = count($created_orders);
        $orders_with_warnings = $this->db->query("SELECT COUNT(*) as count FROM project WHERE id_project IN (" . implode(',', $created_orders) . ") AND warning_flag = 1")->row()->count;

        echo "Total orders created: {$total_orders}\n";
        echo "Orders with warnings: {$orders_with_warnings}\n";
        echo "Orders without warnings: " . ($total_orders - $orders_with_warnings) . "\n";

        echo "\n=== TEST COMPLETED ===\n";
    }    /**
     * Test all 8 warning scenarios
     */
    public function all_scenarios()
    {
        header('Content-Type: text/plain; charset=utf-8');

        echo "=== TEST ALL 8 WARNING SCENARIOS ===\n\n";

        // ===== SETUP TEST DATA =====
        echo "1. SETUP TEST DATA\n";
        echo "-------------------\n";

        // Reset stock - đủ cho scenario 1
        $this->db->query("UPDATE finished_stock SET quantity_in_stock = 100 WHERE id_product = 1001");

        // Reset materials - đủ cho hầu hết scenarios
        $this->db->query("UPDATE material SET stock = 10000 WHERE id_material IN (1001, 1002, 1003, 1006)");

        // Clear existing test orders
        $this->db->query("DELETE FROM project WHERE customer_request LIKE 'TESTCASE%'");

        echo "✓ Reset stock: 100 units of product 1001\n";
        echo "✓ Reset materials: 10000 units each\n";
        echo "✓ Cleared existing test orders\n\n";

        // ===== CREATE ALL 8 TEST SCENARIOS =====
        echo "2. CREATING ALL 8 TEST SCENARIOS\n";
        echo "----------------------------------\n";

        $test_cases = [
            [
                'name' => 'TESTCASE 1: Stock Available',
                'id_product' => 1001,
                'qty_request' => 50, // < 100 stock available
                'entry_date' => date('Y-m-d', strtotime('+7 days')), // Future date
                'expected_badge' => 'info'
            ],
            [
                'name' => 'TESTCASE 2: Normal Production',
                'id_product' => 1001,
                'qty_request' => 150, // > 100 stock, need production
                'entry_date' => date('Y-m-d', strtotime('+7 days')), // Future date
                'expected_badge' => 'success'
            ],
            [
                'name' => 'TESTCASE 3: Material Shortage',
                'id_product' => 1001,
                'qty_request' => 200, // Need production
                'entry_date' => date('Y-m-d', strtotime('+7 days')), // Future date
                'setup' => "UPDATE material SET stock = 100 WHERE id_material = 1001", // Low material
                'expected_badge' => 'warning'
            ],
            [
                'name' => 'TESTCASE 4: Level 2 Required',
                'id_product' => 1001,
                'qty_request' => 500, // Large quantity requiring Level 2
                'entry_date' => date('Y-m-d', strtotime('+2 days')), // Soon deadline
                'expected_badge' => 'warning'
            ],
            [
                'name' => 'TESTCASE 5: Capacity Shortage',
                'id_product' => 1001,
                'qty_request' => 2000, // Too large for capacity
                'entry_date' => date('Y-m-d', strtotime('+1 day')), // Very soon
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 6: Missing BOM',
                'id_product' => 1001,
                'qty_request' => 100,
                'entry_date' => date('Y-m-d', strtotime('+7 days')),
                'setup' => "UPDATE product SET bom = '[{\"material_name\":\"Missing Material\",\"quantity_per_unit\":1}]' WHERE id_product = 1001",
                'cleanup' => "UPDATE product SET bom = '[{\"id_material\":1001,\"material_name\":\"Plastic\",\"quantity_per_unit\":2},{\"id_material\":1002,\"material_name\":\"Ink\",\"quantity_per_unit\":1},{\"id_material\":1003,\"material_name\":\"Spring\",\"quantity_per_unit\":1}]' WHERE id_product = 1001",
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 7: NULL Materials',
                'id_product' => 1001,
                'qty_request' => 100,
                'entry_date' => date('Y-m-d', strtotime('+7 days')),
                'setup' => "UPDATE product SET bom = '[{\"id_material\":null,\"material_name\":\"NULL Material\",\"quantity_per_unit\":1}]' WHERE id_product = 1001",
                'cleanup' => "UPDATE product SET bom = '[{\"id_material\":1001,\"material_name\":\"Plastic\",\"quantity_per_unit\":2},{\"id_material\":1002,\"material_name\":\"Ink\",\"quantity_per_unit\":1},{\"id_material\":1003,\"material_name\":\"Spring\",\"quantity_per_unit\":1}]' WHERE id_product = 1001",
                'expected_badge' => 'danger'
            ],
            [
                'name' => 'TESTCASE 8: Deadline Passed',
                'id_product' => 1001,
                'qty_request' => 100,
                'entry_date' => date('Y-m-d', strtotime('-1 day')), // Past date
                'expected_badge' => 'dark'
            ]
        ];

        $created_orders = [];

        foreach ($test_cases as $i => $test) {
            echo "Creating {$test['name']}...\n";

            // Setup if needed
            if (isset($test['setup'])) {
                $this->db->query($test['setup']);
                echo "  - Setup: {$test['setup']}\n";
            }

            // Create order
            $order = [
                'id_cust' => 1001,
                'id_product' => $test['id_product'],
                'diameter' => 0.5,
                'qty_request' => $test['qty_request'],
                'entry_date' => $test['entry_date'],
                'pr_status' => 1,
                'customer_request' => $test['name']
            ];

            $result = $this->OrderModel->createOrder($order);

            if ($result['success']) {
                $created_orders[] = $result['id_project'];
                echo "  ✓ SUCCESS - Project ID: {$result['id_project']}\n";
                echo "  - Expected badge: {$test['expected_badge']}\n";
            } else {
                echo "  ✗ FAILED - {$result['message']}\n";
            }

            // Cleanup if needed
            if (isset($test['cleanup'])) {
                $this->db->query($test['cleanup']);
                echo "  - Cleanup: {$test['cleanup']}\n";
            }

            echo "\n";
        }

        // ===== VERIFY RESULTS =====
        echo "3. VERIFYING RESULTS\n";
        echo "--------------------\n";

        foreach ($created_orders as $order_id) {
            $order = $this->db->select('id_project, customer_request, warning_details, capacity_level_used')
                             ->where('id_project', $order_id)
                             ->get('project')->row();

            echo "Order {$order->id_project} ({$order->customer_request}):\n";

            if (!empty($order->warning_details)) {
                $warnings = json_decode($order->warning_details, true);

                // Determine badge color based on warnings
                $badge_color = 'success';
                if (isset($warnings['missing_materials_warning'])) {
                    $badge_color = 'danger';
                    echo "  - MISSING MATERIALS: {$warnings['missing_materials_warning']}\n";
                } elseif (isset($warnings['deadline_passed'])) {
                    $badge_color = 'dark';
                    echo "  - DEADLINE PASSED: {$warnings['deadline_passed']}\n";
                } elseif (isset($warnings['material_warning'])) {
                    $badge_color = 'warning';
                    echo "  - MATERIAL WARNING: {$warnings['material_warning']}\n";
                } elseif (isset($warnings['capacity_warning'])) {
                    $badge_color = 'warning';
                    echo "  - CAPACITY WARNING: {$warnings['capacity_warning']}\n";
                } elseif (isset($warnings['stock_status']) && $warnings['stock_status'] === 'sufficient') {
                    $badge_color = 'info';
                    echo "  - STOCK AVAILABLE: {$warnings['finished_stock_info']}\n";
                }

                // Check if badge matches expected
                $test_index = array_search($order_id, $created_orders);
                if ($test_index !== false) {
                    $expected = $test_cases[$test_index]['expected_badge'];
                    if ($badge_color === $expected) {
                        echo "  ✓ BADGE CORRECT: {$badge_color}\n";
                    } else {
                        echo "  ✗ BADGE WRONG: Expected {$expected}, Got {$badge_color}\n";
                    }
                }

                // Show key warnings
                if (isset($warnings['material_status'])) {
                    echo "  - Material Status: {$warnings['material_status']}\n";
                }
                if (isset($warnings['capacity_info'])) {
                    echo "  - Capacity Level: {$warnings['capacity_info']['level']}\n";
                }

            } else {
                echo "No warnings\n";
            }
        }

        // ===== SUMMARY =====
        echo "\n4. SUMMARY\n";
        echo "----------\n";

        $total_orders = count($created_orders);
        $orders_with_warnings = $this->db->query("SELECT COUNT(*) as count FROM project WHERE id_project IN (" . implode(',', $created_orders) . ") AND warning_flag = 1")->row()->count;

        echo "Total orders created: {$total_orders}\n";
        echo "Orders with warnings: {$orders_with_warnings}\n";
        echo "Orders without warnings: " . ($total_orders - $orders_with_warnings) . "\n";

        echo "\n=== TEST COMPLETED ===\n";
    }